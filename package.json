{
  "name": "jrny-plan",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/check-e2e-env.mjs && playwright test decisions.spec.ts scheduling.spec.ts accessibility.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "test:integrations": "node scripts/check-real-integrations.mjs",
    "test:migration": "vitest run convex/migration.test.ts",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:e2e": "npm run test:browser",
    "test:e2e:ui": "node scripts/check-e2e-env.mjs && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "vite preview",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "npx @convex-dev/static-hosting deploy --dist dist/client"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.0.0-alpha.1",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.36",
    "@x402/fetch": "^2.25.0",
    "agentmail": "^0.5.23",
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svix": "^2.3.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "convex-test": "^0.0.56",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
