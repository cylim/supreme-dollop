{
  "name": "jrny-plan",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "test": "vitest run",
    "test:e2e": "node scripts/check-e2e-env.mjs && playwright test",
    "test:e2e:ui": "node scripts/check-e2e-env.mjs && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "npx @convex-dev/static-hosting deploy --dist dist/client"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.0.0-alpha.1",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.36",
    "@x402/fetch": "^2.25.0",
    "agentmail": "^0.5.23",
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svix": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.5",
    "convex-test": "^0.0.56",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
